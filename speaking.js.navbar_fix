                                <svg class="sd-stat-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21l-1.813-5.096L2.096 14.09 7.187 13l1-5.09 1.813 5.09 5.09 1.096-5.09 1.096zM19.096 4.09L21 9l-1.813-5.096L14.09 2.096 19.187 1l1 5.09 1.813-5.09-1.813-5.09z" />
