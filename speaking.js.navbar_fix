                                    </svg>
                                    11-14 min Est. time
                                </div>
                                <div class="pp-pill">
                                    <svg class="pp-pill-icon" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
