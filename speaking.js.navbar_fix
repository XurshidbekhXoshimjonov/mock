    const state = {
        section: null,
        test: null,
        cueRecord: null,
        partRecords: {},
        fullCurrentPart: 1,
        fullRecords: {},
        cuePrepStatus: "not_started",
        fullPrepStatus: {},
        partTimeFinished: {},
