                        justify-content: center;
                    }
                    .sd-bg-circle-tr-inner {
                        width: 290px;
                        height: 290px;
                        border-radius: 50%;
                        border: 1px solid rgba(37, 99, 235, 0.04);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }
                    .sd-bg-circle-tr-innermost {
                        width: 220px;
                        height: 220px;
                        border-radius: 50%;
                        border: 1px solid rgba(37, 99, 235, 0.03);
                    }
                    .sd-bg-circle-bl {
                        bottom: -120px;
                        left: -120px;
                        width: 360px;
                        height: 360px;
                        border-radius: 50%;
                        border: 1px solid rgba(37, 99, 235, 0.05);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }
                    .sd-bg-circle-bl-inner {
                        width: 290px;
                        height: 290px;
                        border-radius: 50%;
                        border: 1px solid rgba(37, 99, 235, 0.04);
                    }
                    
                    /* Hero Header */
                    .sd-hero {
                        position: relative;
                        z-index: 1;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        gap: 40px;
                        margin-bottom: 48px;
