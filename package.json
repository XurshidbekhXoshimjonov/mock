{
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint premium.js premium-config.js lib/security-headers.js",
    "typecheck": "tsc --noEmit --allowJs --checkJs --skipLibCheck --target ES2022 --module ESNext --moduleResolution node premium.js types/browser-globals.d.ts",
    "test": "node --test tests/*.test.js",
    "test:writing-calibration": "node scripts/run-writing-calibration.js",
    "build": "npm run build:reading-css",
    "build:reading-css": "tailwindcss -i ./reading-tailwind.input.css -o ./reading-tailwind.generated.css --minify",
    "reset:users": "node scripts/reset-users-keep-admin.js"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@google-cloud/translate": "^9.4.2",
    "@paddle/paddle-js": "^1.6.4",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "multer": "^2.2.0",
    "openai": "^6.44.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "qs": "6.15.3",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
