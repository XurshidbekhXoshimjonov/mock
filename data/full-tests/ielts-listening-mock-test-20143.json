mpetition Map\">\n</div>\n<div class=\"drag-drop-container\">\n<div class=\"questions-container\">\n<div class=\"matching-question-item\">\n<div class=\"question-line\">\n<span class=\"question-text\"><strong>15</strong> Registration area</span>\n<div id=\"q15\" class=\"drop-zone\"><span class=\"placeholder\">15</span></div>\n</div>\n</div>\n<div class=\"matching-question-item\">\n<div class=\"question-line\">\n<span class=\"question-text\"><strong>16</strong> Shore fishing area</span>\n<div id=\"q16\" class=\"drop-zone\"><span class=\"placeholder\">16</span></div>\n</div>\n</div>\n<div class=\"matching-question-item\">\n<div class=\"question-line\">\n<span class=\"question-text\"><strong>17</strong> Boat launching area</span>\n<div id=\"q17\" class=\"drop-zone\"><span class=\"placeholder\">17</span></div>\n</div>\n</div>\n<div class=\"matching-question-item\">\n<div class=\"question-line\">\n<span class=\"question-text\"><strong>18</strong> Judging area</span>\n<div id=\"q18\" class=\"drop-zone\"><span class=\"placeholder\">18</span></div>\n</div>\n</div>\n<div class=\"matching-question-item\">\n<div class=\"question-line\">\n<span class=\"question-text\"><strong>19</strong> Dining area</span>\n<div id=\"q19\" class=\"drop-zone\"><span class=\"placeholder\">19</span></div>\n</div>\n</div>\n<div class=\"matching-question-item\">\n<div class=\"question-line\">\n<span class=\"question-text\"><strong>20</strong> Prize-giving area</span>\n<div id=\"q20\" class=\"drop-zone\"><span class=\"placeholder\">20</span></div>\n</div>\n</div>\n</div>\n<div class=\"drag-options-container map-options-list\">\n<div class=\"drag-item\" data-value=\"A\"><strong>A</strong>A</div>\n<div class=\"drag-item\" data-value=\"B\"><strong>B</strong>B</div>\n<div class=\"drag-item\" data-value=\"C\"><strong>C</strong>C</div>\n<div class=\"drag-item\" data-value=\"D\"><strong>D</strong>D</div>\n<div class=\"drag-item\" data-value=\"E\"><strong>E</strong>E</div>\n<div class=\"drag-item\" data-valu